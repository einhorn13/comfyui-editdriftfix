    {
      "id": 18, "type": "MarkdownNote", "pos": [40, 880], "size": [760, 190], "flags": {}, "order": 16, "mode": 0,
      "title": "How this graph works",
      "inputs": [],
      "outputs": [],
      "properties": {},
      "widgets_values": ["MiniMax H3 Image works at 4-20 MP, so the original is upscaled first. The **upscaled** picture goes both into the model and into `source` of Edit Drift Fix: the result then keeps the model resolution, and every pixel outside the edit is the upscaled original.\n\nTo get the result at the size of the original file instead, connect `Original` straight to `source`.\n\nThe prompt describes the finished picture: bind what you refer to as `<Subject N>` to `<Picture 1>`, say what the target shows, then what is changed and what is preserved."]
    }
